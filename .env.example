# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）。
# 程序通过环境变量读取，未设置 .env 时也可直接 export / set 这些变量。

# ── 必填 ──
# Anthropic API Key，LLM 指令解析与问答模式使用。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── 选填 ──
# OpenAlex 免费 API Key（问答模式文献检索）。前端表单未填时回退此值；
# 留空则匿名访问（可能受限流）。
OPENALEX_API_KEY=

# OpenAlex 请求读超时（秒），默认 25。
OPENALEX_TIMEOUT=25

# 说明：Zotero API Key / User ID 由前端表单逐次传入，不在此配置。
