# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）。
# 程序通过环境变量读取，未设置 .env 时也可直接 export / set 这些变量。

# ── 必填 ──
# Anthropic API Key，LLM 指令解析与问答模式使用。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── 选填 ──
# OpenAlex 免费 API Key（问答模式文献检索）。前端表单未填时回退此值；
# 留空则匿名访问（可能受限流）。
OPENALEX_API_KEY=

# OpenAlex 请求读超时（秒），默认 25。
OPENALEX_TIMEOUT=25

# 说明：Zotero API Key / User ID 由前端表单逐次传入，不在此配置。

# ── 多服务编排（Docker / 本地调试）──
# Redis 连接（队列 + 进度 pub/sub + 会话消息）。
# 生产由 compose 注入 redis://redis:6379/0；本地原生开发用 localhost。
REDIS_URL=redis://localhost:6379/0

# 独立渲染服务地址（LibreOffice 域计算 + 高保真 PDF/预览）。
# 留空或不可达时，/render/* 友好降级，其余功能不受影响（Windows 无渲染容器即可本地开发）。
RENDER_SERVICE_URL=http://localhost:8001

# 元数据 SQLite 所在目录（内含 app.db）。默认仓库根的 data/。
DATA_DIR=data

# 会话保留天数，超期由 APScheduler 清理 sessions/ + 记录 + 关联 Redis key。
SESSION_TTL_DAYS=14

# 签名 Cookie 密钥（最小认证用）。生产务必改为随机长串：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# 是否启用账号 + 会话归属校验。
#   false（默认）：行为与改造前一致，单用户本地开发零摩擦
#   true：启用登录，堵住「猜中 session UUID 即可访问任意会话」漏洞
# 小范围多人部署建议 true（生产 compose 已置 true），首个账号经 /auth/register 创建。
AUTH_ENABLED=false

# ── 仅生产 Caddy ──
# 反代对外域名；设了即自动签发 Let's Encrypt 证书。缺省 localhost(自签)。
# SITE_ADDRESS=your-domain.edu.cn
